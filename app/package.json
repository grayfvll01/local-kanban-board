{
  "name": "local-kanban",
  "private": true,
  "version": "1.0.0",
  "description": "A private, local-first Kanban board for Windows",
  "type": "module",
  "scripts": {
    "dev": "tauri dev",
    "dev:vite": "vite --host 127.0.0.1 --port 1420",
    "build": "tauri build",
    "build:vite": "tsc && vite build",
    "preview": "vite preview",
    "typecheck": "tsc --noEmit",
    "test": "node --test tests/board.test.ts",
    "test:rust": "cargo test --locked --manifest-path src-tauri/Cargo.toml",
    "check": "npm run version:check && npm run typecheck && npm test && npm run build:vite && cargo check --locked --manifest-path src-tauri/Cargo.toml",
    "version:set": "node scripts/sync-version.mjs",
    "version:check": "node scripts/sync-version.mjs --check",
    "release:notes": "node scripts/release-notes.mjs"
  },
  "dependencies": {
    "@tauri-apps/api": "^2.9.0",
    "@tauri-apps/plugin-process": "^2.4.0",
    "@tauri-apps/plugin-updater": "^2.13.0",
    "clsx": "^2.1.1",
    "date-fns": "^4.4.0",
    "lucide-react": "^0.511.0",
    "react": "^19.3.0",
    "react-dom": "^19.3.0",
    "react-markdown": "^10.1.0",
    "remark-gfm": "^4.0.1"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.11.5",
    "@types/react": "^19.3.0",
    "@types/react-dom": "^19.3.0",
    "@vitejs/plugin-react": "^5.0.0",
    "autoprefixer": "^10.6.1",
    "postcss": "^8.5.28",
    "tailwindcss": "^3.4.17",
    "typescript": "^5.8.3",
    "vite": "^6.3.5"
  },
  "license": "MIT",
  "repository": {
    "type": "git",
    "url": "https://github.com/grayfvll01/local-kanban-board.git"
  },
  "engines": {
    "node": ">=22.18"
  }
}
